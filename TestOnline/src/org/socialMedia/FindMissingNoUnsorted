
class FindMissingNoUnsorted {
    public static void main(String[] args) {
        
        int n[]={3,1,5};
        //Arrays.sort(n);
    for(int i=0;i<n.length-1;i++){
        for(int j=i+1;j<n.length;j++){
            if(n[i]>n[j]){
                int tmp=n[i];
                n[i]=n[j];
                n[j]=tmp;
            }
        }
    }
        
        for(int i=0;i<n.length-1;i++){
            for(int j=n[i]+1;j<n[i+1];j++){
                  System.out.println(j);
            }
        }
        
    }
}
